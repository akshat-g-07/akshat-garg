{
  "name": "akshat-garg",
  "private": true,
  "scripts": {
    "build:macos-portfolio": "turbo build --filter=macos-portfolio",
    "build:threejs-portfolio": "turbo build --filter=threejs-portfolio",
    "build:treklicious-fe": "turbo build --filter=treklicious-fe",
    "build:ratventure-fe": "turbo run build --filter=ratventure-fe",
    "build:treklicious-be": "turbo build --filter=treklicious-be...",
    "build:treklicious": "turbo build --filter=treklicious-*",
    "build:ratventure": "turbo build --filter=ratventure-fe",
    "build": "turbo build",
    "dev:macos-portfolio": "turbo dev --filter=macos-portfolio",
    "dev:treklicious-fe": "turbo dev --filter=treklicious-constants --filter=treklicious-fe",
    "dev:ratventure-fe": "turbo dev --filter=ratventure-fe",
    "dev:treklicious-be": "turbo dev --filter=treklicious-constants --filter=treklicious-be",
    "dev:ratventure-be": "turbo dev --filter=ratventure-be",
    "dev:treklicious": "turbo dev --filter=*treklicious-*",
    "dev:ratventure": "turbo dev --filter=ratventure-*",
    "dev:threejs-portfolio": "turbo dev --filter=threejs-portfolio",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format:write": "prettier --write \"**/*.{js,jsx,mdx}\" --cache"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "turbo": "^2.10.9"
  },
  "overrides": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-avatar-edit": {
      "react": "^19.2.8"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
